+
+bool UITask::isWiFiConnected() const {
+  return (WiFi.status() == WL_CONNECTED);
+}
+
+void UITask::toggleWiFi() {
+  if (!_node_prefs) return;
+  bool new_state = !_node_prefs->wifi_enabled;
+  _node_prefs->wifi_enabled = new_state ? 1 : 0;
+  the_mesh.savePrefs();
+
+  if (new_state) {
+    const char* ssid = _node_prefs->getWifiSSID();
+    if (ssid[0]) {
+      WiFi.mode(WIFI_STA);
+      WiFi.setAutoReconnect(true);
+      WiFi.begin(ssid, _node_prefs->wifi_pwd);
+    }
+    enableWiFi();
+  } else {
+    WiFi.disconnect(true);
+    WiFi.mode(WIFI_OFF);
+    disableWiFi();
+  }
+  _next_refresh = 0;
+}
